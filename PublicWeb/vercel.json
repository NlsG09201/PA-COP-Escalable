{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "node ../scripts/prepare-vercel.mjs PublicWeb && npm ci",
  "buildCommand": "ng build",
  "outputDirectory": "dist/PublicWeb/browser",
  "rewrites": [
    {
      "source": "/render-api/:path*",
      "destination": "https://cop-nest-api.onrender.com/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/env.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
