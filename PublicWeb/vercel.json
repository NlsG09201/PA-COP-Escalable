{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "dist/PublicWeb/browser",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://YOUR_RENDER_API_HOST/api/$1" },
    { "source": "/public/(.*)", "destination": "https://YOUR_RENDER_API_HOST/public/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/env.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
