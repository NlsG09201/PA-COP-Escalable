# Copia a .env en la raíz del repo (no commitear .env).
# Valores por defecto en compose.yaml son SOLO para desarrollo local.

# --- MongoDB ---
MONGO_ROOT_USERNAME=cop
MONGO_ROOT_PASSWORD=genera-un-password-largo
MONGO_REPLICA_SET_KEY=base64-like-key-min-6-chars

# --- Nest API ---
MONGODB_URL=mongodb+srv://nelsondavid1954:<db_password>@cluster0.5dduzba.mongodb.net/?appName=Cluster0
REDIS_URL=redis://redis:6379
JWT_SECRET=genera-un-secreto-largo-aleatorio
JWT_ACCESS_EXPIRES=45m
NODE_ENV=production
CORS_ORIGINS=https://tu-panel.ejemplo.com,https://tu-web-publica.ejemplo.com

# Bootstrap admin (solo primer despliegue; luego rotar password)
APP_BOOTSTRAP_ADMIN_USERNAME=
APP_BOOTSTRAP_ADMIN_PASSWORD=
APP_BOOTSTRAP_ADMIN_EMAIL=
APP_BOOTSTRAP_ENFORCE_SOLE_ADMIN=true

# URLs públicas
PUBLIC_API_ORIGIN=https://api.tu-dominio.com
DASHBOARD_URL=https://panel.tu-dominio.com
PUBLIC_SITE_URL=https://www.tu-dominio.com

# Pagos Wompi (Colombia)
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
# NUNCA en producción:
# WOMPI_SKIP_WEBHOOK_VERIFY=true

# Google OAuth (opcional)
GOOGLE_CLIENT_ID=

# Frontends (build args Docker)
API_BASE_URL=
PUBLICWEB_API_BASE_URL=

# J48
J48_URL=http://j48-python:8080

# Notificaciones (opcional)
