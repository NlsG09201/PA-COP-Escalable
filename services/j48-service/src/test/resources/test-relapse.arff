@RELATION relapse_risk_test

@ATTRIBUTE gender {M, F, O}
@ATTRIBUTE age_group {YOUNG_ADULT, ADULT, SENIOR}
@ATTRIBUTE sentiment {POSITIVE, NEUTRAL, NEGATIVE}
@ATTRIBUTE wellbeing {HIGH, MEDIUM, LOW}
@ATTRIBUTE anxiety NUMERIC
@ATTRIBUTE depression NUMERIC
@ATTRIBUTE attendance {REGULAR, IRREGULAR}
@ATTRIBUTE days_since_last NUMERIC
@ATTRIBUTE risk_level {LOW, MEDIUM, HIGH}

@DATA
M,ADULT,POSITIVE,HIGH,0.10,0.10,REGULAR,2,LOW
F,ADULT,NEUTRAL,MEDIUM,0.55,0.45,REGULAR,15,MEDIUM
O,SENIOR,NEGATIVE,LOW,0.90,0.80,IRREGULAR,60,HIGH
M,YOUNG_ADULT,POSITIVE,HIGH,0.20,0.15,REGULAR,5,LOW
F,SENIOR,NEUTRAL,MEDIUM,0.60,0.50,IRREGULAR,25,MEDIUM
O,ADULT,NEGATIVE,LOW,0.85,0.75,IRREGULAR,40,HIGH
