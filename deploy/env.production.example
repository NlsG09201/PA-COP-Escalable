# =============================================================================
# PLANTILLA — NO copies este archivo tal cual a Render.
# Sustituye cada valor por el real de Atlas / Upstash / tus dominios .onrender.com
# =============================================================================

# MongoDB Atlas — sustituye <db_password> por la contraseña real del usuario.
# Atlas → Network Access → Allow 0.0.0.0/0 (si no, Render no conecta).
# Colecciones: docs/MONGODB_ATLAS_COLECCIONES.md
MONGODB_URL=mongodb+srv://nelsonherazoi:<NelsonH09092001>@cluster0.6oyhyja.mongodb.net/cop?retryWrites=true&w=majority&appName=Cluster0

# Redis — Upstash → pestaña del database → copia "Redis URL" (TLS, empieza por rediss://).
# NO uses: redis-cli, your-instance.upstash.io, YOUR_UPSTASH_TOKEN (son ejemplos).
# Ejemplo de forma (host y token son los tuyos): rediss://default:XXXX@prepared-ram-78507.upstash.io:6379
REDIS_URL=REDIS_URL="rediss://default:********@prepared-ram-78507.upstash.io:6379"

# Nest JWT
JWT_SECRET=change-me-long-random-string
JWT_ACCESS_EXPIRES=45m

# J48 microservicio Python en Render — SOLO la base URL (Nest añade /predict)
# Ejemplo: https://cop-j48-python.onrender.com
# NO uses .../predict al final (el código Nest normaliza ambos formatos).
J48_URL=https://cop-j48-python.onrender.com

# Google Sign-In (OAuth 2.0 Web client)
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com

# Bootstrap admin (primer arranque)
APP_BOOTSTRAP_ADMIN_USERNAME=admin
APP_BOOTSTRAP_ADMIN_PASSWORD=use-a-strong-secret
APP_BOOTSTRAP_ADMIN_EMAIL=admin@tu-dominio.com
APP_BOOTSTRAP_ENFORCE_SOLE_ADMIN=true
APP_BOOTSTRAP_ADMIN_ORG_ID=your-org-uuid

# URLs públicas (Render: sustituye por tus nombres de servicio si difieren)
PUBLIC_API_ORIGIN=https://cop-nest-api.onrender.com
DASHBOARD_URL=https://cop-web-dashboard.onrender.com
PUBLIC_SITE_URL=https://cop-web-public.onrender.com

# Next.js (build en Render / Vercel) — debe coincidir con PUBLIC_API_ORIGIN
NEXT_PUBLIC_API_URL=https://cop-nest-api.onrender.com

# CORS (obligatorio en producción: orígenes exactos del front)
CORS_ORIGINS=https://cop-web-public.onrender.com,https://cop-web-dashboard.onrender.com

# Seed sedes Colombia al arrancar
SEED_COLOMBIA_SITES=true

# J48 batch scoring
J48_SCORE_BATCH_MAX=15000
J48_SCORE_CONCURRENCY=12

# Wompi (Colombia)
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# Pagos internacionales (opcional)
STRIPE_SECRET_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# Microservicios IA (opcional) — base URL pública HTTPS de cada Web Service en Render.
# Debes crear 3 servicios Docker aparte (carpetas services/*) o dejar vacío para no usar el proxy /api/diagnosis, /api/emotion, /api/relapse.
# Sustituye el subdominio si en Render pusiste otros nombres de servicio.
AI_DIAGNOSIS_URL=https://cop-ai-diagnosis.onrender.com
AI_EMOTION_URL=https://cop-emotion-analysis.onrender.com
AI_RELAPSE_URL=https://cop-recommendation-engine.onrender.com
