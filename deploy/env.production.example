# MongoDB Atlas (replica set URI)
MONGODB_URL=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/cop_escalable?retryWrites=true&w=majority

# Redis (Render Redis, Upstash, or ElastiCache)
REDIS_URL=rediss://default:PASSWORD@HOST:6379

# Nest JWT
JWT_SECRET=change-me-long-random-string
JWT_ACCESS_EXPIRES=45m

# J48 microservice (Render internal URL or public)
J48_URL=https://cop-j48-service.onrender.com/predict

# Google Sign-In (OAuth 2.0 Web client)
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com

# Bootstrap admin (first deploy only)
APP_BOOTSTRAP_ADMIN_USERNAME=nelsonh09
APP_BOOTSTRAP_ADMIN_PASSWORD=use-a-strong-secret
APP_BOOTSTRAP_ADMIN_EMAIL=nelsondavid1954@gmail.com
APP_BOOTSTRAP_ENFORCE_SOLE_ADMIN=true
APP_BOOTSTRAP_ADMIN_ORG_ID=your-org-uuid

# Public URLs
PUBLIC_API_ORIGIN=https://cop-nest-api.onrender.com
DASHBOARD_URL=https://your-dashboard.vercel.app
PUBLIC_SITE_URL=https://your-public-web.vercel.app

# Seed sedes Colombia al arrancar
SEED_COLOMBIA_SITES=true

# J48 batch scoring
J48_SCORE_BATCH_MAX=15000
J48_SCORE_CONCURRENCY=12
